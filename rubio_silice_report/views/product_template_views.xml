<odoo>
    <record id="product_template_form_view_silicie" model="ir.ui.view">
        <field name="name">product.template.form.silicie</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="SILICIE" name="silicie_config">
                    <group>
                        <group string="Configuración Básica SILICIE">
                            <field name="silicie_codigo_producto"/>
                            <field name="silicie_codigo_nc"/>
                            <field name="silicie_unidad_medida"/>
                            <field name="numero_silice"/>
                        </group>
                        <group string="Alcohol (IESA1CSV)">
                            <field name="silicie_graduacion"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="product_template_tree_view_silicie" model="ir.ui.view">
        <field name="name">product.template.tree.silicie</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="after">
                <field name="silicie_codigo_producto" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
