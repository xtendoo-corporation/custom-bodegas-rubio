<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista formulario de stock.picking con campo silice_sequence -->
    <record id="view_picking_form_silice_sequence" model="ir.ui.view">
        <field name="name">stock.picking.form.silice.sequence</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="silice_sequence" readonly="1"/>
            </field>
        </field>
    </record>

    <!-- Vista árbol de stock.picking con campo silice_sequence -->
    <record id="view_picking_tree_silice_sequence" model="ir.ui.view">
        <field name="name">stock.picking.tree.silice.sequence</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="silice_sequence" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
