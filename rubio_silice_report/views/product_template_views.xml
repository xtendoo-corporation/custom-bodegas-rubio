<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_silicie" model="ir.ui.view">
        <field name="name">product.template.form.silicie</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SILICIE" name="silicie_page">
                    <group name="silicie_group">
                        <group>
                            <field name="silicie_unidad_medida"/>
                            <field name="silicie_graduacion"/>
                            <field name="silicie_descripcion_articulo"/>
                        </group>
                        <group>
                            <field name="silicie_codigo_nc"/>
                            <field name="clave_silicie"/>
                            <field name="silicie_capacidad_envase"/>

                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
