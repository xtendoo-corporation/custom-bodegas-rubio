<odoo>
    <record id="view_order_form_tax_breakdown" model="ir.ui.view">
        <field name="name">sale.order.form.tax.breakdown</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='tax_id']" position="after">
                <field name="tax_breakdown_display" string="Desglose impuestos"/>
            </xpath>
        </field>
    </record>
</odoo>

