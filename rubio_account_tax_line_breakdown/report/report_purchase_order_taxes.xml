<odoo>
    <template id="report_purchaseorder_document_tax_breakdown" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_taxes']" position="after">
            <th name="th_tax_breakdown" class="text-end"><strong>Desglose impuestos</strong></th>
        </xpath>

        <xpath expr="//tbody//t[@t-if='not line.display_type']/td[5]" position="after">
            <td class="text-end">
                <span t-esc="line.tax_breakdown_display"/>
            </td>
        </xpath>
    </template>
</odoo>

