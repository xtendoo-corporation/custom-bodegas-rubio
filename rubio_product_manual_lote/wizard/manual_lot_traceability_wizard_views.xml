<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manual_lot_traceability_wizard_form" model="ir.ui.view">
        <field name="name">manual.lot.traceability.wizard.form</field>
        <field name="model">manual.lot.traceability.wizard</field>
        <field name="arch" type="xml">
            <form string="Trazabilidad lotes manuales">
                <group col="4">
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="product_id" options="{'no_create': True}"/>
                    <field name="lot_number"/>
                </group>
                <footer>
                    <button
                        name="action_open_report"
                        type="object"
                        string="Ver informe"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_manual_lot_traceability_wizard" model="ir.actions.act_window">
        <field name="name">Trazabilidad lotes manuales</field>
        <field name="res_model">manual.lot.traceability.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_manual_lot_traceability_wizard_form"/>
    </record>
</odoo>

