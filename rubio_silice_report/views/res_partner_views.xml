<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_silicie" model="ir.ui.view">
        <field name="name">res.partner.form.silicie</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="SILICIE" name="silicie_group">
                    <field name="silicie_movement_type"/>
                    <field name="cae_seed_number"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="silicie_document_type"/>
                <field name="cae_seed_number"/>
            </xpath>
        </field>
    </record>
</odoo>
