<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_silicie" model="ir.ui.view">
        <field name="name">res.partner.form.silicie</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SILICIE" name="silicie_page">
                    <group name="silicie_group">
                        <group>
                            <field name="silicie_movement_type"/>
                            <field name="silicie_document_type" string="Tipo Documento Identificativo"/>
                            <field name="cae_seed_number" string="CAE/Numero SEED"/>
                            <field name="silicie_regimen_fiscal" string="Régimen Fiscal SILICIE"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
