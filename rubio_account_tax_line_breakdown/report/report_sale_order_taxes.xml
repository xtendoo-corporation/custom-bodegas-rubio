<odoo>
    <template id="report_saleorder_document_tax_breakdown" inherit_id="sale.report_saleorder_document">
        <xpath expr="//th[@name='th_taxes']" position="after">
            <th name="th_tax_breakdown" class="text-end">Desglose impuestos</th>
        </xpath>

        <xpath expr="//td[@name='td_taxes']" position="after">
            <td name="td_tax_breakdown" class="text-end">
                <span t-esc="line.tax_breakdown_display"/>
            </td>
        </xpath>
    </template>
</odoo>

