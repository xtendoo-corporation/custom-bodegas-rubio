<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_manual_lot" model="ir.ui.view">
        <field name="name">sale.order.form.manual.lot</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                position="after"
            >
                <field name="manual_lot" string="Lote Manual" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="sale_order_line_form_readonly_manual_lot" model="ir.ui.view">
        <field name="name">sale.order.line.form.readonly.manual.lot</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="manual_lot" string="Lote Manual"/>
            </xpath>
        </field>
    </record>
</odoo>
